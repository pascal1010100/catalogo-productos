generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  priceMayorista  Float?
  pricePublico    Float?
  minCompra       String?
  precioMinorista Float?
  precioContado   Float?
  unidadesCaja    Int?
}
